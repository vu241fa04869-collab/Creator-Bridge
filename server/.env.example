PORT=8787
# Optional: without MongoDB the API saves briefs to server/data/briefs.json.
MONGODB_URI=
# Required for the live Gemini brief builder. Keep this key on the server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional comma-separated origins, e.g. https://creatorbridge.example,https://your-vercel-app.vercel.app
CORS_ALLOWED_ORIGINS=
